{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/nycpokemap/(.*)", "destination": "https://nycpokemap.com/$1" },
    { "source": "/api/nyc-cloud-sync/(.*)", "destination": "https://ntfy.sh/pokeskills_nyc_sync_v2_salca/$1" },
    { "source": "/api/nyc-cloud-sync", "destination": "https://ntfy.sh/pokeskills_nyc_sync_v2_salca" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
